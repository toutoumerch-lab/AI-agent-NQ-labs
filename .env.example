# ── Data ───────────────────────────────────────────────────────────────────
# Root for CsvProvider: expects {NQLAB_DATA_ROOT}/NQ/5min.csv (or .parquet)
NQLAB_DATA_ROOT=./data

# ── Risk (all configurable; nothing is hardcoded in the engine) ────────────
NQLAB_ACCOUNT_SIZE=100000
NQLAB_RISK_PER_TRADE=0.005
NQLAB_MAX_CONTRACTS=5
NQLAB_DAILY_LOSS_LIMIT=0.02

# ── Backtest cost assumptions (always reported alongside any result) ───────
NQLAB_COMMISSION_PER_CONTRACT=4.00
NQLAB_SLIPPAGE_TICKS=1

# ── LLM (explanation layer only — it can never alter a number) ─────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
